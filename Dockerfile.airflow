# Partimos da imagem oficial do Airflow (compatível com a versão do seu projeto)
FROM apache/airflow:2.9.1-python3.11

# Mudamos temporariamente para o usuário root para podermos instalar pacotes de sistema
USER root

# Instalamos o Java (OpenJDK 17). 
# Isso é fundamental porque o PySpark roda sobre a JVM (Java Virtual Machine). 
# Sem isso, os scripts da camada Bronze, Silver e Gold vão dar erro no Airflow.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
         openjdk-17-jre-headless \
  && apt-get autoremove -yqq --purge \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Definimos a variável de ambiente do Java para que o PySpark saiba onde ele está
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Voltamos para o usuário padrão do airflow (boas práticas de segurança do Docker)
USER airflow

# Copiamos o seu requirements original apenas como base
COPY requirements.txt /tmp/requirements.txt

# Instalamos as bibliotecas necessárias para o PySpark, Delta Lake e a ingestão.
# Removi a exigência de SQLAlchemy>=2.0 porque o Apache Airflow 2.9.1 quebra com SQLAlchemy 2.0.
# O próprio Airflow já gerencia a versão correta do SQLAlchemy internamente (1.4.x).
RUN pip install --no-cache-dir \
    pyspark==3.5.1 \
    delta-spark==3.2.0 \
    pandas \
    boto3 \
    psycopg2-binary
