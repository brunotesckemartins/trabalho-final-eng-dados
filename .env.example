# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# O .env nunca é commitado (está no .gitignore).

# ─── PostgreSQL (banco de origem) ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_HOST=localhost        # use "postgres-origem" dentro da rede Docker
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_db

# ─── MinIO (Data Lake) ────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000  # use "http://minio:9000" dentro da rede Docker
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=adminpassword

# ─── Camada de Visualização (DuckDB) ─────────────────────────────────────────
DUCKDB_PATH=visualization/analytics.duckdb
